# Template only. Confirm domain and certificate paths before installation.
server {
    listen 443 ssl;
    server_name education.example.invalid;
    ssl_certificate /etc/letsencrypt/live/education.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/education.example.invalid/privkey.pem;
    root /srv/financial-education/web/dist-financial;
    index index.html;
    location /api/ {
        proxy_pass http://127.0.0.1:3100;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 180s;
    }
    location /socket.io/ {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }
    location /financial-education/ {
        try_files $uri =404;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
