[Unit]
Description=Financial education ai API (2026-09-20)
After=network.target mysql.service
[Service]
Type=simple
User=financial-education
Group=financial-education
WorkingDirectory=/srv/financial-education/ai
EnvironmentFile=/etc/financial-education/ai.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/financial-education/ai/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8100
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/financial-education/data
[Install]
WantedBy=multi-user.target
